{
  "name": "alchemy",
  "version": "2.0.0-beta.84",
  "description": "Infrastructure as Effects for TypeScript.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "alchemy": "./bin/cli.js"
  },
  "files": [
    "bin",
    "!bin/register-dev-mode.js",
    "lib",
    "src",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "default": "./lib/*.js"
    },
    "./Auth": {
      "types": "./lib/Auth/index.d.ts",
      "bun": "./src/Auth/index.ts",
      "default": "./lib/Auth/index.js"
    },
    "./Alchemist": {
      "types": "./lib/Alchemist/index.d.ts",
      "bun": "./src/Alchemist/index.ts",
      "default": "./lib/Alchemist/index.js"
    },
    "./Command": {
      "types": "./lib/Command/index.d.ts",
      "bun": "./src/Command/index.ts",
      "default": "./lib/Command/index.js"
    },
    "./Bundle": {
      "types": "./lib/Bundle/index.d.ts",
      "bun": "./src/Bundle/index.ts",
      "default": "./lib/Bundle/index.js"
    },
    "./Cli": {
      "types": "./lib/Cli/index.d.ts",
      "bun": "./src/Cli/index.ts",
      "default": "./lib/Cli/index.js"
    },
    "./Cli/CliKit": {
      "types": "./lib/Cli/CliKit/index.d.ts",
      "bun": "./src/Cli/CliKit/index.ts",
      "default": "./lib/Cli/CliKit/index.js"
    },
    "./Runtime/Bootstrap": {
      "types": "./src/Runtime/Bootstrap.ts",
      "bun": "./src/Runtime/Bootstrap.ts",
      "default": "./src/Runtime/Bootstrap.ts"
    },
    "./Runtime/ManagedHttpShutdown": {
      "types": "./src/Runtime/ManagedHttpShutdown.ts",
      "bun": "./src/Runtime/ManagedHttpShutdown.ts",
      "default": "./src/Runtime/ManagedHttpShutdown.ts"
    },
    "./Secrets": {
      "types": "./lib/Secrets/index.d.ts",
      "bun": "./src/Secrets/index.ts",
      "default": "./lib/Secrets/index.js"
    },
    "./State": {
      "types": "./lib/State/index.d.ts",
      "bun": "./src/State/index.ts",
      "default": "./lib/State/index.js"
    },
    "./Util": {
      "types": "./lib/Util/index.d.ts",
      "bun": "./src/Util/index.ts",
      "default": "./lib/Util/index.js"
    },
    "./bin/alchemy.js": "./bin/alchemy.js",
    "./bin/exec.js": "./bin/exec.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@alchemy.run/node-utils": "2.0.0-beta.84",
    "@alchemy.run/sigil": "0.1.0-alpha.1",
    "capnweb": "^0.12.0",
    "fflate": "^0.8.3",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.7",
    "rolldown": "1.2.13",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@effect/vitest": "^4.0.5",
    "@oxc-project/types": "^0.153.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "alchemy-test": "0.0.0",
    "astro": "7.3.8",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "^4.0.5",
    "hono": "^4.12.14",
    "next": "16.2.10",
    "nuxt": "4.6.1",
    "react": "^19.3.0",
    "react-devtools-core": "^7.0.1",
    "solid-js": "^1.9.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@effect/vitest": "^4.0.5",
    "effect": "^4.0.5",
    "vite": "^8.0.7",
    "ws": "^8.21.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/frontend-frameworks": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/vitest": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "clear:state": "cd ../../ && bun clear:state",
    "pretest": "pnpm -w ensure:built",
    "test": "alchemy-test",
    "nuke": "cd ../../ && bun nuke"
  }
}